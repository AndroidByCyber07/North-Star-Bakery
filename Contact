<link rel="stylesheet" href="styles.css">

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>North Star Bakery | Contact and Pre-Orders</title>

</head>

<body>

    <header>

        <img src="bakery-logo.png" alt="North Star Bakery logo">

        <h1>Contact North Star Bakery</h1>

        <p>Ask a question or request a pre-order for pickup.</p>

        <nav>

            <ul>

                <li><a href="index.html">Home</a></li>

                <li><a href="products.html">Products</a></li>

                <li><a href="about.html">About Us</a></li>

                <li><a href="contact.html">Contact and Pre-Orders</a></li>

            </ul>

        </nav>

    </header>

    <main>

        <section>

            <h2>Pre-Order and Inquiry Form</h2>

            <form action="#" method="post">

                <fieldset>

                    <legend>Your Contact Information</legend>

                    <p>

                        <label for="name">Name:</label><br>

                        <input type="text"

                               id="name"

                               name="name"

                               required

                               minlength="2">

                    </p>

                    <p>

                        <label for="email">Email:</label><br>

                        <input type="email"

                               id="email"

                               name="email"

                               required>

                    </p>

                </fieldset>

                <fieldset>

                    <legend>Request Details</legend>

                    <p>

                        <label for="pickup-date">Pickup Date:</label><br>

                        <input type="date"

                               id="pickup-date"

                               name="pickup-date"

                               required>

                    </p>

                    <p>

                        <label for="request-type">Request Type:</label><br>

                        <select id="request-type" name="request-type" required>

                            <option value="">-- Please choose one --</option>

                            <option value="pre-order">Pre-Order</option>

                            <option value="general-question">General Question</option>

                        </select>

                    </p>

                    <p>

                        <label for="item-details">Item Details:</label><br>

                        <textarea id="item-details"

                                  name="item-details"

                                  rows="6"

                                  cols="40"

                                  required

                                  minlength="5"

                                  placeholder="Tell us what you would like to order or ask about."></textarea>

                    </p>

                    <p>

                        <label for="allergy-notes">Allergy Notes, If Applicable:</label><br>

                        <textarea id="allergy-notes"

                                  name="allergy-notes"

                                  rows="4"

                                  cols="40"

                                  placeholder="Please list any allergies or dietary concerns."></textarea>

                    </p>

                </fieldset>

                <p>

                    <button type="submit">Submit Request</button>

                </p>

            </form>

        </section>

        <section>

            <h2>Location and Hours</h2>

            <p>

                <strong>Location:</strong> North Star Bakery neighborhood storefront

            </p>

            <p>

                <strong>Monday-Friday:</strong> 6:30 a.m.-6:00 p.m.<br>

                <strong>Saturday:</strong> 7:00 a.m.-4:00 p.m.<br>

                <strong>Sunday:</strong> Closed

            </p>

        </section>

        <section>

            <h2>Planning an Event?</h2>

            <p>

                We welcome inquiries from families, commuters, and event

                planners. For larger orders, please provide as much information

                as possible so our bakery team can review your request.

            </p>

        </section>

    </main>

    <footer>

        <p>© 2026 North Star Bakery. Freshly baked for our community.</p>

    </footer>

</body>

</html>
